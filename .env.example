# Copia este fichero a `.env` y rellena las claves. `.env` está en .gitignore.

# Groq: el bucle de conversación. Plan gratuito con límites por minuto y por día;
# compruébalos en consola antes de lanzar una tanda larga de mediciones.
GROQ_API_KEY=

# Modelo del bucle. Pequeño y rápido a propósito: el razonamiento difícil,
# si hace falta, sale una sola vez a uno grande.
GROQ_MODEL=openai/gpt-oss-20b

# Deepgram: NO se usa en la primera pasada de medición, para no gastar crédito
# antes de que la sonda esté bien. Se rellena cuando midamos Nova-3 y Aura-2.
DEEPGRAM_API_KEY=

# Dónde vive el expediente de las llamadas. Si no se pone, se usa el de
# `docker-compose.yml`; si tampoco hay base de datos, el sistema sigue
# funcionando y avisa de que el expediente se perderá al colgar.
#   docker compose up -d
EXPEDIENTE_DSN=postgresql://agente:agente_local@127.0.0.1:55432/expediente

# Dónde vive el estado de las llamadas en curso, para que cualquier pasarela
# pueda retomar cualquier turno. Sin Redis el sistema funciona igual, pero la
# llamada solo se puede atender en el proceso que la empezó.
ESTADO_URL=redis://127.0.0.1:56379/0

# Telefonía real (Twilio Media Streams). Solo hace falta para atender llamadas
# de verdad: el canal se puede comprobar entero sin cuenta con
# `python -m app.prueba_telefonia`.
#
# Es la URL pública del WebSocket, con un túnel delante (ngrok o similar):
#   TWILIO_STREAM_URL=wss://algo.ngrok-free.app/twilio
# Si se deja vacía, se deduce de la cabecera Host de la petición, que sirve
# para probar y no para producción: una URL sacada de una cabecera es una URL
# que alguien puede cambiar desde fuera.
TWILIO_STREAM_URL=
